{
  "name": "perc",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build:shared": "npx tsc -p packages/shared/tsconfig.json",
    "build:all": "npm run build:shared && npm run build --workspaces",
    "start:api": "nest start api-gateway",
    "start:workflow": "nest start workflow-service",
    "start:comm": "nest start communication-service",
    "start:timeline": "nest start timeline-service",
    "dev": "npm run build:shared && nest start api-gateway",
    "dev:all": "npm run build:shared && (nest start api-gateway & nest start workflow-service & nest start communication-service & nest start timeline-service & wait)",
    "test": "npm run test --workspaces",
    "test:bus": "npx ts-node scripts/test-bus-orchestration.ts",
    "test:kafka": "npx ts-node scripts/test-kafka-timeline.ts",
    "test:supabase": "npx ts-node scripts/test-supabase-connection-and-seed.ts",
    "test:mock": "npx ts-node packages/mock-orchestrator/src/run.ts",
    "lint": "npm run lint --workspaces"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.1.28",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "~5.7.0"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/typeorm": "^11.0.3",
    "@supabase/supabase-js": "^2.110.8",
    "@types/nodemailer": "^8.0.1",
    "axios": "^1.18.1",
    "kafkajs": "^2.2.4",
    "nodemailer": "^9.0.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sql.js": "^1.14.1",
    "typeorm": "^1.1.0"
  }
}
