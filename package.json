{
  "name": "perc-notification-service",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build:shared": "node node_modules/typescript/bin/tsc -p packages/shared/tsconfig.json",
    "build": "npm run build:shared && node node_modules/@nestjs/cli/bin/nest.js build notification-service",
    "start": "node node_modules/@nestjs/cli/bin/nest.js start notification-service",
    "start:prod": "node dist/packages/notification-service/src/main",
    "dev": "npm run build:shared && node node_modules/@nestjs/cli/bin/nest.js start notification-service --watch",
    "test": "node node_modules/jest/bin/jest.js --passWithNoTests"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.28",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "jest": "^30.4.2",
    "prisma": "^5.22.0"
  },
  "dependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/platform-express": "^11.1.28",
    "@prisma/client": "^5.22.0",
    "@supabase/supabase-js": "^2.110.8",
    "axios": "^1.18.1",
    "kafkajs": "^2.2.4",
    "nodemailer": "^9.0.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "~5.7.0"
  }
}
