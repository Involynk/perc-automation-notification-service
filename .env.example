# ── Server ──
PORT=3000
COMMUNICATION_SERVICE_PORT=3001
WORKFLOW_SERVICE_PORT=3002
COMMUNICATION_SERVICE_URL=http://localhost:3001
WORKFLOW_SERVICE_URL=http://localhost:3002

# ── Supabase (PostgreSQL) ──
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>
SUPABASE_ANON_KEY=<your-anon-key>

# ── WhatsApp Cloud API ──
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=perc_webhook_verify_2026
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0
# Override API base URL for testing with mock orchestrator
# WHATSAPP_API_BASE_URL=http://localhost:9100

# ── Instagram ──
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=perc_ig_webhook_verify_2026
INSTAGRAM_APP_SECRET=
# INSTAGRAM_API_BASE_URL=http://localhost:9100

# ── Facebook Messenger ──
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
FACEBOOK_WEBHOOK_VERIFY_TOKEN=perc_fb_webhook_verify_2026
FACEBOOK_APP_SECRET=
# FACEBOOK_API_BASE_URL=http://localhost:9100

# ── Email (IMAP / SMTP) ──
EMAIL_ADDRESS=
EMAIL_PASSWORD=
EMAIL_IMAP_SERVER=imap.gmail.com
EMAIL_IMAP_PORT=993
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=587
